#!/bin/sh
# Refuse direct pushes to the protected branches. Changes reach them through
# pull requests only: feature branch -> dev -> staging -> main.
# See CONTRIBUTING.md. Bypass in an emergency with `git push --no-verify`.

protected="main staging"
status=0

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  branch="${remote_ref#refs/heads/}"
  for name in $protected; do
    if [ "$branch" = "$name" ]; then
      echo "pre-push: direct push to '$name' is not allowed; open a pull request instead." >&2
      status=1
    fi
  done
done

exit $status
